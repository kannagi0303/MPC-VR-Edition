    COMBOBOX        IDC_COMBO16,64,120,158,170,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Under 5 %, slightly cropped 4K film on a 4K screen, where a neural upscaler gains nothing visible.",IDC_STATIC_SMALL_NOTE,22,136,200,16
