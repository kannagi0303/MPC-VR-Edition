    COMBOBOX        IDC_COMBO8,140,54,82,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Needs the video processor resizing. Not available with DLSS SR or the chroma replacement.",IDC_STATIC_SUPERRES_NOTE,22,70,200,20
