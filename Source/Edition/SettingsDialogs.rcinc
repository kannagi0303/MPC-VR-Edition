// Edition/legacy settings dialogs; included within the parent RC language section.
IDD_SETTINGSPAGE DIALOGEX 0, 0, 480, 228
STYLE DS_SETFONT | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    CONTROL         "",IDC_SECTION_TABS,"SysTabControl32",WS_TABSTOP,5,5,470,200
    LTEXT           "",IDC_EDIT2,5,212,360,8
    PUSHBUTTON      "Default",IDC_BUTTON1,435,209,40,14
END

IDD_SECTION_SOURCE DIALOGEX 0, 0, 460, 180
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    LTEXT           "The rendering engine, its precision, and which video formats the GPU's video processor converts.",IDC_STATIC_DESC_SOURCE,7,4,446,8
    GROUPBOX        "Rendering",IDC_CARD_DECODING,7,16,222,52
    CONTROL         "Use Direct3D 11 (recommended)",IDC_CHECK1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,30,208,10
    LTEXT           "Bit depth",IDC_STATIC,14,48,56,8
    COMBOBOX        IDC_COMBO1,74,46,148,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "GPU video processor",IDC_STATIC1,7,74,222,50
    CONTROL         "NV12",IDC_CHECK7,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,88,100,10
    CONTROL         "P010/P016",IDC_CHECK8,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,118,88,104,10
    CONTROL         "YUY2",IDC_CHECK9,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,104,100,10
    CONTROL         "Other supported formats",IDC_CHECK4,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,118,104,104,10
    GROUPBOX        "Deinterlacing",IDC_STATIC2,235,16,218,72
    LTEXT           "Hardware",IDC_STATIC,242,32,40,8
    COMBOBOX        IDC_COMBO9,286,30,160,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Double the frame rate when deinterlacing",IDC_CHECK3,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,242,50,204,10
    CONTROL         "Blend fields when the shaders convert (4:2:0)",IDC_CHECK17,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,242,66,204,10
END

IDD_SECTION_CHROMA DIALOGEX 0, 0, 460, 180
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    LTEXT           "Restoring full colour resolution from 4:2:0 and 4:2:2 video.",IDC_STATIC_DESC_CHROMA,7,4,446,8
    GROUPBOX        "Chroma upsampling",IDC_CARD_CHROMA,7,16,446,78
    LTEXT           "Method",IDC_STATIC40,14,32,40,8
    COMBOBOX        IDC_COMBO5,58,30,170,140,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Use this method instead of the video processor's chroma upsampling",IDC_CHECK27,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,50,300,10
    LTEXT           "Better 4:4:4 colour detail, while the video processor keeps converting and resizing. RTX Video Super Resolution cannot run on the 4:4:4 picture it then receives.",IDC_STATIC,22,66,424,20
END

IDD_SECTION_SCALING DIALOGEX 0, 0, 460, 180
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    LTEXT           "Resizing the picture to the window. One enlarger runs at a time: DLSS SR, the video processor or the shaders.",IDC_STATIC_DESC_SCALING,7,4,446,8
    GROUPBOX        "Resizing",IDC_CARD_RESIZING,7,16,222,160
