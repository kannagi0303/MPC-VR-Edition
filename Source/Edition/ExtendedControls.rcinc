// Edition settings are an independent child dialog; the parent owns one settings transaction.
IDD_EDITION_EXTENDED_PANE DIALOGEX 0, 0, 342, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    GROUPBOX        "Processing",IDC_STATIC,3,4,162,121
    LTEXT           "DLSS SR / DLAA:",IDC_STATIC,9,17,60,9
    COMBOBOX        IDC_DLSS_SR_SOURCE_LIMIT,9,28,150,83,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Enable DLSS Multi Frame Generation",IDC_MFG_MULTIPLIER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,9,43,150,11
    LTEXT           "Order:",IDC_STATIC,9,59,36,9
    COMBOBOX        IDC_MFG_PROCESSING_MODE,48,57,111,55,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Startup:",IDC_STATIC,9,75,36,9
    COMBOBOX        IDC_EXTENDED_STARTUP,48,73,111,50,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Depth use:",IDC_STATIC,9,91,36,9
    COMBOBOX        IDC_DEPTH_MODE,48,89,111,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "Display Information",IDC_STATIC,3,129,162,64
    CONTROL         "Show Edition information",IDC_MFG_FEATURE_BADGES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,9,141,150,10
    CONTROL         "Include detailed diagnostics",IDC_EDITION_STATS_DETAILS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,154,141,10
    CONTROL         "Show depth overlay",IDC_SHOW_DEPTH_OVERLAY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,9,167,150,10
    CONTROL         "Show optical flow",IDC_SHOW_MFG_MOTION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,9,180,150,10
    GROUPBOX        "Video Enhancement",IDC_STATIC,169,4,170,139
    CONTROL         "Enable video enhancement",IDC_ENHANCEMENT_MASTER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,175,16,158,10
    LTEXT           "Color Enhancement:",IDC_COLOR_LABEL,175,30,158,9
    EDITTEXT        IDC_COLOR_ENHANCEMENT_VALUE,175,40,32,12,ES_AUTOHSCROLL | ES_NUMBER,WS_EX_RIGHT
    LTEXT           "%",IDC_COLOR_PERCENT,210,42,9,9
    CONTROL         "",IDC_VIDEO_ENHANCEMENT,"msctls_trackbar32",WS_TABSTOP | 0x400,222,40,111,12
    LTEXT           "Memory Color:",IDC_MEMORY_LABEL,175,57,158,9
    EDITTEXT        IDC_MEMORY_COLOR_VALUE,175,67,32,12,ES_AUTOHSCROLL | ES_NUMBER,WS_EX_RIGHT
    LTEXT           "%",IDC_MEMORY_PERCENT,210,69,9,9
    CONTROL         "",IDC_MEMORY_COLOR,"msctls_trackbar32",WS_TABSTOP | 0x400,222,67,111,12
    LTEXT           "Skin Tone:",IDC_SKIN_LABEL,175,84,158,9
    EDITTEXT        IDC_SKIN_TONE_VALUE,175,94,32,12,ES_AUTOHSCROLL | ES_NUMBER,WS_EX_RIGHT
    LTEXT           "%",IDC_SKIN_PERCENT,210,96,9,9
    CONTROL         "",IDC_SKIN_TONE,"msctls_trackbar32",WS_TABSTOP | 0x400,222,94,111,12
    LTEXT           "Adaptive Tone:",IDC_TONE_LABEL,175,111,158,9
    EDITTEXT        IDC_ADAPTIVE_TONE_VALUE,175,121,32,12,ES_AUTOHSCROLL | ES_NUMBER,WS_EX_RIGHT
    LTEXT           "%",IDC_TONE_PERCENT,210,123,9,9
    CONTROL         "",IDC_ADAPTIVE_TONE,"msctls_trackbar32",WS_TABSTOP | 0x400,222,121,111,12
    GROUPBOX        "VR Projection",IDC_VR_GROUP,169,147,170,98
    CONTROL         "Fisheye to flat",IDC_JVR_FLAT_VIEW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,175,159,88,11
    COMBOBOX        IDC_JVR_EYE,265,157,68,44,CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "",IDC_JVR_PROFILE_NAME,175,172,158,9,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "Vertical framing:",IDC_VR_VERTICAL_LABEL,175,185,158,9
    EDITTEXT        IDC_JVR_VERTICAL_VALUE,175,195,32,12,ES_AUTOHSCROLL,WS_EX_RIGHT
    LTEXT           "%",IDC_VR_VERTICAL_PERCENT,210,197,9,9
    CONTROL         "",IDC_JVR_VERTICAL,"msctls_trackbar32",WS_TABSTOP | 0x400,222,195,111,12
    LTEXT           "Reprojection:",IDC_VR_REPROJECTION_LABEL,175,212,158,9
    EDITTEXT        IDC_JVR_REPROJECTION_VALUE,175,222,32,12,ES_AUTOHSCROLL | ES_NUMBER,WS_EX_RIGHT
    LTEXT           "%",IDC_VR_REPROJECTION_PERCENT,210,224,9,9
    CONTROL         "",IDC_JVR_REPROJECTION,"msctls_trackbar32",WS_TABSTOP | 0x400,222,222,111,12
END
